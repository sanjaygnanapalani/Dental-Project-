{
  "name": "pdd-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "mocha --config .mocharc.json tests/e2e/**/*.test.js tests/dynamic/**/*.test.js",
    "test:chrome": "cross-env BROWSER=chrome mocha --config .mocharc.json tests/e2e/**/*.test.js",
    "test:firefox": "cross-env BROWSER=firefox mocha --config .mocharc.json tests/e2e/**/*.test.js",
    "test:edge": "cross-env BROWSER=edge mocha --config .mocharc.json tests/e2e/**/*.test.js",
    "test:headless": "cross-env HEADLESS=true mocha --config .mocharc.json tests/e2e/**/*.test.js",
    "test:dynamic": "mocha --config .mocharc.json tests/dynamic/dynamicFormDiscovery.test.js",
    "test:all": "mocha --config .mocharc.json tests/**/*.test.js",
    "test:load": "k6 run load-tests/scenarios/baselineLoadTest.js",
    "test:load:report": "k6 run load-tests/scenarios/baselineLoadTest.js",
    "test:security": "node vulnerability-tests/scripts/runVulnerabilityScan.js"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "localforage": "^1.10.0",
    "lucide-react": "^1.26.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.10.0",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@babel/parser": "^7.26.9",
    "@babel/traverse": "^7.26.9",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "chai": "^5.2.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "mocha": "^11.1.0",
    "mochawesome": "^7.1.3",
    "mochawesome-report-generator": "^6.2.0",
    "oxlint": "^1.71.0",
    "selenium-webdriver": "^4.28.1",
    "vite": "^8.1.1",
    "wait-on": "^8.0.2",
    "winston": "^3.17.0"
  }
}
